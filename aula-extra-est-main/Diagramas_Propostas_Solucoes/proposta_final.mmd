sequenceDiagram
    autonumber
    actor Aluno
    participant Site as Site / App
    participant API as API (Backend)
    participant BD as Base de Dados
    participant Video as API Vídeo (Telemetria)
    actor Professor

    %% ==========================================
    %% FASE 1 e 2: PAGAMENTO E AGENDAMENTO (ESCROW)
    %% ==========================================
    rect rgb(240, 248, 255)
    Note over Aluno, Professor: FASE 1 e 2: Marcação e Cativação de Fundos (Sem Fatura/IVA)
    
    Aluno->>Site: Escolhe professor, data e hora
    Site->>API: Submete pedido (idempotencyKey, detalhes)
    API->>BD: Criar `ReservationPayment` (status = pending)
    API->>API: Calcula price e commission_amount
    
    alt Pagamento com Sucesso (Top-up ou Saldo)
        API->>BD: Debitar `Wallet` do Aluno (Transaction type=debit)
        API->>BD: Atualizar `ReservationPayment` = cativo (escrow)
        Note right of API: Emite apenas Recibo Não-Fiscal (Créditos MPV)
        API->>BD: Criar `Enrollment` (Associa aluno à aula)
        API-->>Site: Confirmação de reserva
        Site-->>Aluno: Mostrar sucesso e Recibo MPV
        API->>Professor: Notificação de aula marcada
    else Pagamento Pendente / Falha (Ex: 3DS, Sem saldo)
        API-->>Site: Redirecionar para retry ou 3DS
    end
    end

    %% ==========================================
    %% FASE 3: OCORRÊNCIA, TELEMETRIA E FALTAS
    %% ==========================================
    rect rgb(245, 255, 250)
    Note over Aluno, Professor: FASE 3: A Aula, Cancelamentos e Telemetria
    
    alt Cancelamento Prévio (> 24 Horas)
        Aluno->>Site: Cancela a aula
        Site->>API: Processa cancelamento atempado
        API->>BD: Devolve fundos à `Wallet` do Aluno (Transaction type=refund)
        API->>BD: Atualiza `ReservationPayment` = cancelled
        API->>Site: Algoritmo: Vaga ganha "Prioridade Máxima"
        API->>Professor: Notifica cancelamento e reabertura de vaga
        
    else Aula Ocorre ou Falta (< 24 Horas)
        Note over API, Video: Chega a hora da aula
        API->>Video: Inicia monitorização da sala virtual
        Video-->>API: Envia Logs (Tempo de permanência do Prof e Aluno)
        
        alt Falha Crítica do Professor (< 50% do tempo)
            API->>BD: Atualiza `ReservationPayment` = failed_by_tutor
            API->>BD: Estorno 100% para a `Wallet` do Aluno
            API->>Professor: Notifica anulação por quebra técnica
            
        else Falta do Aluno / Atraso (< 24h)
            API->>BD: Atualiza `ReservationPayment` = pending_completion
            Note right of API: Fundos retidos a 100% para o Professor
            
            opt O "Botão de Bom Karma" (Janela de 48h)
                Aluno->>Professor: Envia justificação (Ex: "Tive um furo no pneu")
                alt Professor clica em "Perdoar Falta"
                    Professor->>Site: Aciona "Perdoar Falta"
                    Site->>API: Confirma perdão
                    API->>BD: Devolve 100% à `Wallet` do Aluno (Refund limpo)
                end
            end
            
        else Aula Decorre Normalmente (Ambos Presentes >= 50%)
            API->>BD: Atualiza `ReservationPayment` = pending_completion
            
            opt Válvula de Segurança: Disputa ODR
                Aluno->>Site: Abre disputa (Problema com o Prof)
                Site->>API: Cria `Dispute` (status = pending)
                API->>BD: Pausa as 48h até resolução
            end
        end
    end
    end

    %% ==========================================
    %% FASE 4: LIQUIDAÇÃO E FATURAÇÃO (IVA)
    %% ==========================================
    rect rgb(253, 245, 230)
    Note over Aluno, Professor: FASE 4: Liquidação, Faturação e Levantamento
    
    Note over API: Passam 48h (Sem perdão ativo e Sem disputas)
    API->>BD: Atualiza `ReservationPayment` = completed
    
    Note right of API: FACTO GERADOR DO IVA (Momento Exato)
    API->>BD: Cria Registo de Fatura (Self-billing: Prof -> Aluno)
    API->>BD: Cria Registo de Fatura de Comissão (Plataforma -> Prof)
    
    API->>BD: Credita `Wallet` do Professor (Valor Líquido)
    
    Professor->>Site: Solicita Levantamento (Cash-out)
    Site->>API: Processa Cash-out
    API->>BD: API do Stripe transfere dinheiro para o Banco
    API-->>Professor: Notifica transferência efetuada
    end