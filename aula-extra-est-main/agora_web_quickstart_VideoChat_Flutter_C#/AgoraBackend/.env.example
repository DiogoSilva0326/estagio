# Backend (C#) - variáveis obrigatórias

# Agora RTC (Video Chat)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Netless Whiteboard
NETLESS_SDK_TOKEN=
NETLESS_REGION=us-sv

# Agora Chat (opcional - para usar API real do Agora Chat)
# Formato: orgName#appName (exemplo: 411427678#1628083)
AGORA_CHAT_APP_KEY=
AGORA_CHAT_CLIENT_ID=
AGORA_CHAT_CLIENT_SECRET=

# Server
PORT=8082
