# Example env (não commitar .env real)

AGORA_APP_ID=
DEFAULT_CHANNEL=teste

# New Synget.AgoraIntegrator.API endpoint (recommended)
API_BASE_URL=http://localhost:5050

# Legacy endpoints (still supported for backward compatibility)
TOKEN_SERVER_URL=http://localhost:8082/fetch_rtc_token
WHITEBOARD_TOKEN_URL=http://localhost:8082/fetch_whiteboard_token

WHITEBOARD_APP_IDENTIFIER=
WHITEBOARD_REGION=us-sv

# Opcional: valores hardcoded do whiteboard (normalmente vêm do backend)
WHITEBOARD_UUID=
WHITEBOARD_ROOM_TOKEN=

# Backend-only (não deve estar no frontend)
AGORA_APP_CERTIFICATE=
NETLESS_SDK_TOKEN=
NETLESS_REGION=us-sv
